    "Volume, theme, accent and the active tab will return to defaults. Favorites, history and custom stations are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Səs səviyyəsi, mövzu, vurğu və aktiv tab standart dəyərlərə qayıdacaq. Sevimlilər, tarixçə və xüsusi stansiyalar saxlanılır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke, Erscheinungsbild, Akzent und der aktive Tab werden zurückgesetzt. Favoriten, Verlauf und eigene Stationen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume, theme, accent and the active tab will return to defaults. Favorites, history and custom stations are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volumen, el tema, el acento y la pestaña activa volverán a sus valores por defecto. Favoritos, historial y estaciones personalizadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume, le thème, l'accent et l'onglet actif reviendront aux valeurs par défaut. Favoris, historique et stations personnalisées sont conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、テーマ、アクセント、有効なタブが既定値に戻ります。お気に入り、履歴、カスタム局は保持されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Громкость, тема, акцент и активная вкладка вернутся к значениям по умолчанию. Избранное, история и свои станции сохранятся."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音量、主题、强调色和当前标签将恢复为默认。收藏、历史和自定义电台保留。"
          }
        }
      }
    },
